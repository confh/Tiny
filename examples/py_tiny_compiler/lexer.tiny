import "./tokens.tiny" as tokens
import std "io"
import std "json"

fn isAlpha(ch: string): bool {
    if ch.length() != 1 {
        return false;
    }
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".includes(ch);
}

fn isDigit(ch: string): bool {
    if ch.length() != 1 {
        return false;
    }
    return "0123456789".includes(ch);
}

fn isIdent(ch: string): bool {
    if ch.length() != 1 {
        return false;
    }
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".includes(ch);
}

export class Lexer {
    field source: string;
    field pos: number;
    field len: number;
    field indentStack: array;
    field pendingTokens: array;
    field pendingPos: number;
    field atLineStart: bool;

    fn init(src: string) {
        this.source = src;
        this.pos = 0;
        this.len = src.length();
        this.indentStack = [0];
        this.pendingTokens = [];
        this.pendingPos = 0;
        this.atLineStart = true;
    }

    fn peekChar(): string {
        if this.pos >= this.len {
            return "";
        }
        return this.source.substring(this.pos, this.pos + 1);
    }

    fn nextChar(): string {
        let ch = this.peekChar();
        this.pos = this.pos + 1;
        return ch;
    }

    fn scanToken(): tokens.Token {
        // Return queued tokens first
        if this.pendingPos < this.pendingTokens.length() {
            let tok = this.pendingTokens[this.pendingPos];
            this.pendingPos = this.pendingPos + 1;
            return tok;
        }

        // Reset queue if exhausted
        if this.pendingPos > 0 {
            this.pendingTokens.clear();
            this.pendingPos = 0;
        }

        // Handle indentation at start of lines
        if this.atLineStart {
            this.atLineStart = false;
            let spaces = 0;
            while this.pos < this.len {
                let ch = this.peekChar();
                if ch == " " {
                    spaces = spaces + 1;
                    this.pos = this.pos + 1;
                } else if ch == "\t" {
                    spaces = spaces + 4; // tab = 4 spaces
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }

            let nextCh = this.peekChar();
            // Skip indentation changes for empty/newline-only/comment lines
            if (nextCh != "\n" and nextCh != "\r" and nextCh != "#" and this.pos < this.len) {
                let currentIndent = this.indentStack[this.indentStack.length() - 1];
                if spaces > currentIndent {
                    this.indentStack.push(spaces);
                    let t = tokens.Token();
                    t.type = tokens.TokenType.INDENT;
                    t.value = spaces;
                    this.pendingTokens.push(t);
                } else if spaces < currentIndent {
                    while (this.indentStack.length() > 0 and spaces < this.indentStack[this.indentStack.length() - 1]) {
                        this.indentStack.pop();
                        let t = tokens.Token();
                        t.type = tokens.TokenType.DEDENT;
                        t.value = spaces;
                        this.pendingTokens.push(t);
                    }
                    if spaces != this.indentStack[this.indentStack.length() - 1] {
                        io.println("Lexer Error: inconsistent indentation");
                        throw "Inconsistent indentation";
                    }
                }
            }

            if this.pendingTokens.length() > 0 {
                let tok = this.pendingTokens[0];
                this.pendingPos = 1;
                return tok;
            }
        }

        // Skip comments starting with '#'
        if this.peekChar() == "#" {
            while (this.pos < this.len and this.peekChar() != "\n" and this.peekChar() != "\r") {
                this.pos = this.pos + 1;
            }
        }

        // Skip whitespace that is not at the start of a line
        while this.pos < this.len {
            let ch = this.peekChar();
            if ch == " " or ch == "\t" {
                this.pos = this.pos + 1;
            } else {
                break;
            }
        }

        // EOF check
        if this.pos >= this.len {
            // Unwind remaining indentation stack down to 0
            while this.indentStack.length() > 1 {
                this.indentStack.pop();
                let t = tokens.Token();
                t.type = tokens.TokenType.DEDENT;
                t.value = 0;
                this.pendingTokens.push(t);
            }
            let eofTok = tokens.Token();
            eofTok.type = tokens.TokenType.EOF;
            eofTok.value = "";
            this.pendingTokens.push(eofTok);

            let tok = this.pendingTokens[0];
            this.pendingPos = 1;
            return tok;
        }

        let ch = this.peekChar();

        // Handle newlines
        if ch == "\n" or ch == "\r" {
            this.pos = this.pos + 1;
            if ch == "\r" and this.peekChar() == "\n" {
                this.pos = this.pos + 1;
            }
            this.atLineStart = true;
            let tok = tokens.Token();
            tok.type = tokens.TokenType.NEWLINE;
            tok.value = "\n";
            return tok;
        }

        // Check for string literals
        if ch == "\"" or ch == "'" {
            let quote = ch;
            this.pos = this.pos + 1; // skip opening quote
            let start = this.pos;
            while this.pos < this.len {
                let nextCh = this.peekChar();
                if nextCh == quote {
                    break;
                } else if nextCh == "" {
                    io.println("Lexer Error: Unterminated string literal");
                    throw "Unterminated string literal";
                } else {
                    this.pos = this.pos + 1;
                }
            }
            let text = this.source.substring(start, this.pos);
            this.pos = this.pos + 1; // skip closing quote
            let tok = tokens.Token();
            tok.type = tokens.TokenType.STRING;
            tok.value = text;
            return tok;
        }

        // Check for identifier/keywords
        if isAlpha(ch) or ch == "_" {
            let start = this.pos;
            while this.pos < this.len {
                let nextCh = this.peekChar();
                if isIdent(nextCh) {
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }
            let text = this.source.substring(start, this.pos);
            let tok = tokens.Token();
            match text {
                "print"  { tok.type = tokens.TokenType.PRINT; }
                "def"    { tok.type = tokens.TokenType.DEF; }
                "return" { tok.type = tokens.TokenType.RETURN; }
                _        { tok.type = tokens.TokenType.IDENT; }
            }
            tok.value = text;
            return tok;
        }

        // Check for numbers
        if isDigit(ch) {
            let start = this.pos;
            let hasDot = false;
            while this.pos < this.len {
                let nextCh = this.peekChar();
                if nextCh == "." {
                    hasDot = true;
                    this.pos = this.pos + 1;
                } else if isDigit(nextCh) {
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }
            let text = this.source.substring(start, this.pos);
            let tok = tokens.Token();
            tok.type = tokens.TokenType.NUMBER;
            tok.value = json.parse(text);
            return tok;
        }

        this.pos++;
        let tok = tokens.Token();

        match ch {
            "+" { tok.type = tokens.TokenType.PLUS; }
            "-" { tok.type = tokens.TokenType.MINUS; }
            "*" { tok.type = tokens.TokenType.STAR; }
            "/" { tok.type = tokens.TokenType.SLASH; }
            "=" { tok.type = tokens.TokenType.EQUAL; }
            ":" { tok.type = tokens.TokenType.COLON; }
            "," { tok.type = tokens.TokenType.COMMA; }
            "(" { tok.type = tokens.TokenType.LPAREN; }
            ")" { tok.type = tokens.TokenType.RPAREN; }
            _   { tok.type = ch; }
        }

        tok.value = ch;
        return tok;
    }
}
