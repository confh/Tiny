import std "sqlite"
import std "io"
import std "json"

// Open (or create) a SQLite database file
let db = sqlite.open("app.db")

// Create a table
db.execute(`CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    active INTEGER DEFAULT 1
)`)

// Insert rows with parameterized queries
db.execute("INSERT INTO users (name, email) VALUES (?, ?)", ["Alice", "alice@example.com"])
db.execute("INSERT INTO users (name, email) VALUES (?, ?)", ["Bob", "bob@example.com"])
db.execute("INSERT INTO users (name, email) VALUES (?, ?)", ["Charlie", "charlie@example.com"])

io.println(`Inserted ${db.lastInsertId()} as the last row ID`)

// Query all rows
let allUsers = db.query("SELECT * FROM users")
io.println(`\nAll users (${allUsers.length()}):`)
for user in allUsers {
    io.println(`  [${user.id}] ${user.name} <${user.email}> active=${user.active}`)
}

// Query a single row
let alice = db.queryRow("SELECT * FROM users WHERE name = ?", ["Alice"])
if alice != null {
    io.println(`\nFound: ${alice.name} <${alice.email}>`)
}

// Update a row
let updated = db.execute("UPDATE users SET active = 0 WHERE name = ?", ["Bob"])
io.println(`\nDeactivated ${updated} user(s)`)

// Query with condition
let inactive = db.query("SELECT name FROM users WHERE active = 0")
io.println("\nInactive users:")
for user in inactive {
    io.println(`  ${user.name}`)
}

// Clean up
db.close()
io.println("\nDatabase closed.")
