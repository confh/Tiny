import std "http"
import std "io"
import std "json"

let server = http.server(8090)

server.get("/", fn(req) {
    return http.json({
        message: "hello from Tiny",
        routes:["/echo?text=hello"]
    })
})

server.get("/echo", fn(req) {
    let text = req.query?.text ?? "missing text query"

    return http.json({
        path: req.path,
        method: req.method,
        text: text
    })
})


server.get("/test/:id", fn(req) {
    const id: string = req.params?.id

    return http.json({
        id: id
    })
})

io.println("Tiny server running at http://localhost:8090")
server.start()
