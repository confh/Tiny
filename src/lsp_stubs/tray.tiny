export interface Bounds {
    x: number,
    y: number,
    width: number,
    height: number
}

// Represents a system tray icon with its context menu and callbacks.
class Tray {
    // Sets the tray icon from PNG bytes.
    // Example:
    // const app = tray.new()
    // app.setIcon(iconBytes)
    fn setIcon(icon: buffer): null {}

    // Sets the dark-mode tray icon from PNG bytes when supported by the platform.
    // Example:
    // app.setDarkModeIcon(darkIconBytes)
    fn setDarkModeIcon(icon: buffer): null {}

    // Sets the macOS template tray icon from PNG bytes.
    // Example:
    // app.setTemplateIcon(templateIconBytes)
    fn setTemplateIcon(icon: buffer): null {}

    // Sets the tooltip shown when the user hovers the tray icon.
    // Example:
    // app.setTooltip("Sync is running")
    fn setTooltip(text: string): null {}

    // Alias for setTooltip.
    // Example:
    // app.setToolTip("Sync is running")
    fn setToolTip(text: string): null {}

    // Adds a normal menu item to the tray context menu.
    // Example:
    // app.add("Open", fn() {
    //     io.println("Open clicked")
    // })
    fn add(label: string, callback: function): null {}

    // Adds a normal menu item with a PNG icon to the tray context menu.
    // Example:
    // app.addWithIcon("Open", openIconBytes, fn() {
    //     io.println("Open clicked")
    // })
    fn addWithIcon(label: string, icon: buffer, callback: function): null {}

    // Adds a visual separator to the tray context menu.
    // Example:
    // app.add("Open", fn() {})
    // app.addSeparator()
    // app.add("Quit", fn() { app.quit() })
    fn addSeparator(): null {}

    // Adds a checkbox menu item to the tray context menu.
    // Example:
    // app.addCheckbox("Enable sync", true, fn() {
    //     io.println("Sync toggled")
    // })
    fn addCheckbox(label: string, checked: bool, callback: function): null {}

    // Registers a left-click handler for the tray icon.
    // Example:
    // app.onClick(fn() {
    //     app.notify("Tiny", "Tray clicked")
    // })
    fn onClick(callback: function): null {}

    // Registers a double-click handler for the tray icon.
    // Example:
    // app.onDoubleClick(fn() {
    //     io.println("Tray double-clicked")
    // })
    fn onDoubleClick(callback: function): null {}

    // Registers a right-click handler for the tray icon.
    // Example:
    // app.onRightClick(fn() {
    //     io.println("Tray right-clicked")
    // })
    fn onRightClick(callback: function): null {}

    // Shows an OS-level notification.
    // Example:
    // app.notify("Download complete", "Your file is ready")
    fn notify(title: string, message: string): null {}

    // Alias for notify.
    // Example:
    // app.showNotification("Download complete", "Your file is ready")
    fn showNotification(title: string, message: string): null {}

    // Shows the tray icon. This also attaches the menu built with add/addCheckbox/addSeparator.
    // Example:
    // app.show()
    fn show(): null {}

    // Hides the tray icon without destroying it.
    // Example:
    // app.hide()
    fn hide(): null {}

    // Runs the platform tray message loop. This blocks until the tray is removed.
    // Example:
    // app.show()
    // app.run()
    fn run(): null {}

    // Removes the tray icon and releases tray resources.
    // Example:
    // app.add("Quit", fn() {
    //     app.remove()
    // })
    fn remove(): null {}

    // Alias for remove.
    // Example:
    // app.add("Quit", fn() {
    //     app.quit()
    // })
    fn quit(): null {}

    // Returns the tray icon bounds as { x, y, width, height }.
    // Example:
    // const area = app.bounds()
    // io.println(area.x)
    fn bounds(): Bounds {}
}

// Creates a new system tray icon.
// Example:
// const app = tray.new()
// app.setTooltip("Tiny App")
export fn new(): Tray {}
