// Suspends execution of the current thread for the specified milliseconds.
export fn sleep(ms: number): null {}

// Returns the current Unix timestamp in nanoseconds.
export fn nowNs(): number {}

// Returns the current Unix timestamp in milliseconds.
export fn nowMs(): number {}

// Returns the current Unix timestamp in seconds.
export fn nowSec(): number {}

// Returns the elapsed CPU execution time in seconds.
export fn clock(): number {}