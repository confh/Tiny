export enum TimerType {
    Timer,
    Ticker,
}

export enum TimeUnit {
    Seconds = "s",
    Milliseconds = "ms",
    Nanoseconds = "ns",
}

// Represents a scheduled timer or interval.
export class Timer {
// Cancels the timer.
    fn cancel(): null
// Resets the timer with a new interval.
    fn reset(ms: number): null
// Returns the timer type.
    fn type(): TimerType
}

// Sleeps for the specified number of milliseconds.
export fn sleep(ms: number): null
// Returns the current time in nanoseconds.
export fn nowNs(): number
// Returns the current time in milliseconds.
export fn nowMs(): number
// Returns the current time in seconds.
export fn nowSec(): number
// Parses a Unix timestamp string.
export fn parseUnix(timestamp: string, unit: TimeUnit): number
// Returns a high-resolution clock value.
export fn clock(): number
// Creates a one-shot timer.
export fn timeout(ms: number, func: function): Timer
// Creates a repeating interval timer.
export fn interval(ms: number, func: function): Timer
