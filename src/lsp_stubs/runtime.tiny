export interface MemoryStats {
    alloc: number,
    totalAlloc: number,
    sys: number,
    numGC: number
}

// Locks the current OS thread to the active goroutine/execution state.
export fn lockThread(): null {}

// Unlocks the current OS thread from the active goroutine/execution state.
export fn unlockThread(): null {}

// Registers a callback to run when a fatal runtime error occurs.
export fn onFatal(callback: function): null {}

// Clears the registered fatal runtime error callback handler.
export fn clearFatalHandler(): null {}

// Returns an object containing memory allocation statistics.
export fn memoryStats(): MemoryStats {}

// Triggers a garbage collection run to reclaim unused memory.
export fn gc(): null {}

// Returns whether or not the running app was packed by `tiny pack`
export fn isPacked(): bool {}