export interface MemoryStats {
    alloc: number,
    totalAlloc: number,
    sys: number,
    numGC: number,
}

// Controls which standard library modules are enabled in a VM instance.
export interface VMStdlibOptions {
    array?: bool,
    math?: bool,
    strings?: bool,
    json?: bool,
    fs?: bool,
    app?: bool,
    buffer?: bool,
    regex?: bool,
    io?: bool,
    process?: bool,
    time?: bool,
    error?: bool,
    http?: bool,
    os?: bool,
    runtime?: bool,
    net?: bool,
    path?: bool,
    object?: bool,
    observer?: bool,
    desktop?: bool,
    sync?: bool,
    tests?: bool,
    ui?: bool,
    websocket?: bool,
    tray?: bool,
    validate?: bool,
    url?: bool,
}

// Options for creating a new VM instance.
export interface VMOptions {
// Run the VM in isolated mode.
    isolated?: bool,
// Controls which standard library modules are enabled.
    allowedStdlib?: VMStdlibOptions,
// Command-line arguments for the VM.
    cliArgs?: array,
// Global variables available in the VM.
    globals?: object,
// Disable the JIT compiler.
    disableJIT?: bool,
// Run the main function on load.
    runMainOnLoad?: bool,
}

// Represents a sandboxed virtual machine instance.
export class VM {
// Loads compiled bytecode into the VM.
    fn loadBytecode(bytes: buffer | string): VM
// Loads and compiles source code into the VM.
    fn loadSource(source: string, file?: string): VM
// Runs the loaded program.
    fn run(): null
// Calls a function by name.
    fn call(name: string, args?: array): any
// Checks if a function exists in the VM.
    fn functionExists(name: string): bool
// Lists all defined function names.
    fn listFunctions(): array:string
// Stops the VM.
    fn stop(): VM
// Resets the VM state.
    fn reset(): VM
// Sets a global variable.
    fn setGlobal(name: string, value: any): VM
// Exposes a Go function to the VM.
    fn exposeFunction(name: string, func: function): VM
// Returns information about the VM.
    fn info(): object
}

// Creates a new VM instance.
export fn newVM(options?: VMOptions): VM
// Locks the current goroutine to the OS thread.
export fn lockThread(): null
// Unlocks the current goroutine from the OS thread.
export fn unlockThread(): null
// Registers a handler for fatal errors.
export fn onFatal(callback: function): null
// Clears the fatal error handler.
export fn clearFatalHandler(): null
// Returns memory allocation statistics.
export fn memoryStats(): MemoryStats
// Triggers garbage collection.
export fn gc(): null
// Returns true if running from a packed binary.
export fn isPacked(): bool
// Compiles source code to bytecode.
export fn compileSource(source: string, file?: string): buffer
// Compiles a file to bytecode.
export fn compileFile(path: string): buffer
// Returns the runtime version string.
export fn version(): string
