import std "io";

// Helper to convert bool to string
fn boolToString(val) {
    if val {
        return "true";
    }
    return "false";
}

// Test 1: Object Creation, Reading, and Writing
fn testObjects() {
    let obj = { x: 10, y: 20, label: "point" };
    
    // Test basic retrieval
    let xOk = obj.x == 10;
    let yOk = obj.y == 20;
    let labelOk = obj.label == "point";
    
    // Test writing
    obj.x = 42;
    obj.y = 84;
    obj.label = "modified";
    
    let xWriteOk = obj.x == 42;
    let yWriteOk = obj.y == 84;
    let labelWriteOk = obj.label == "modified";
    
    return xOk and yOk and labelOk and xWriteOk and yWriteOk and labelWriteOk;
}

// Test 2: Array Creation, Length, Reading, and Writing
fn testArrays() {
    let arr = [100, 200, 300];
    
    // Test length
    let lenOk = arr.length() == 3;
    
    // Test index access
    let idx0Ok = arr[0] == 100;
    let idx1Ok = arr[1] == 200;
    let idx2Ok = arr[2] == 300;
    
    // Test modifying index
    arr[1] = 999;
    let writeOk = arr[1] == 999;
    
    // Test pushing
    arr.push(400);
    let pushLenOk = arr.length() == 4;
    let pushValOk = arr[3] == 400;
    
    return lenOk and idx0Ok and idx1Ok and idx2Ok and writeOk and pushLenOk and pushValOk;
}

// Test 3: Complex Type Coercions and String Concat (without OP_STRING_JOIN)
fn testCoercion(a, b, num) {
    // String + Number
    let s1 = a + 500; // "value: 500"
    
    // String + String
    let s2 = a + b; // "value: test"
    
    // Separate statements to prevent bytecode optimizer OP_STRING_JOIN coalescing
    let s3 = b + " code: ";
    s3 = s3 + (num + 100); // "test code: 142"
    
    return [s1, s2, s3];
}

// Test 4: Nested Call and Recursive Logic with Array Accumulation
fn testNestedCallsAndRecursion(n) {
    if n <= 0 {
        return [];
    }
    let sub = testNestedCallsAndRecursion(n - 1);
    sub.push(n * 10);
    return sub;
}

// Test 5: Logical Operations and Control Flow (AND, OR, NOT)
fn testLogicalFlow(a, b, c) {
    let cond1 = a > 5 and b < 10;
    let cond2 = b == 0 or c == "match";
    let cond3 = !cond1;
    
    let result = 0;
    if cond1 and cond2 {
        result = 1;
    } else if cond3 or cond2 {
        result = 2;
    } else {
        result = 3;
    }
    return result;
}

fn verifyAll() {
    // Force interpreter execution by adding an unsupported operation
    if false {
        "dummy".notJitSafe();
    }

    let objRes = testObjects();
    io.println("Objects Result: " + boolToString(objRes));
    
    let arrRes = testArrays();
    io.println("Arrays Result: " + boolToString(arrRes));
    
    let coercionRes = testCoercion("value: ", "test", 42);
    let c0Ok = coercionRes[0] == "value: 500";
    let c1Ok = coercionRes[1] == "value: test";
    let c2Ok = coercionRes[2] == "test code: 142.000000";
    let coercionOk = c0Ok and c1Ok and c2Ok;
    io.println("Coercion Result: " + boolToString(coercionOk));
    if !coercionOk {
        io.println("  coercionRes[0] = " + coercionRes[0]);
        io.println("  coercionRes[1] = " + coercionRes[1]);
        io.println("  coercionRes[2] = " + coercionRes[2]);
    }
    
    let recRes = testNestedCallsAndRecursion(5);
    let recOk = recRes.length() == 5 and recRes[0] == 10 and recRes[4] == 50;
    io.println("Recursion Result: " + boolToString(recOk));
    
    let f1 = testLogicalFlow(10, 5, "match") == 1; // cond1:true and cond2:true -> 1
    let f2 = testLogicalFlow(3, 5, "no-match") == 2; // cond1:false, cond3:true or cond2:false -> 2
    let flowOk = f1 and f2;
    io.println("Logical Flow Result: " + boolToString(flowOk));
    
    return objRes and arrRes and coercionOk and recOk and flowOk;
}

fn runComprehensiveJitSuite() {
    io.println("=== Running Comprehensive JIT Suite ===");
    let passed = verifyAll();
    if passed {
        io.println("All JIT tests passed successfully!");
    } else {
        io.println("JIT test verification failed!");
    }
}

runComprehensiveJitSuite();
